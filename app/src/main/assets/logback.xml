<configuration>
    <!-- Explicit layout keeps release-mode Joran configuration independent of
         reflection-based encoder inference and obfuscated constructor names. -->
    <appender name="logcat" class="ch.qos.logback.classic.android.LogcatAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>[%thread] %logger{12} - %msg%n</pattern>
        </layout>
    </appender>
    <root level="INFO">
        <appender-ref ref="logcat"/>
    </root>
</configuration>
